# Copy to .env and fill in. Lines left empty keep that feature in simulated mode.

# Dashboard password (required for real use).
ORTHO_ADMIN_PASSWORD=

# Public https address of this server; used in the links patients receive.
ORTHO_PUBLIC_URL=http://localhost:8000

# AI plan drafting.
ANTHROPIC_API_KEY=

# Telegram bot (from @BotFather). Optional chat id for staff alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# WhatsApp Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_PLAN=
WHATSAPP_TEMPLATE_FOLLOWUP=
